PORT=5000
# Local MongoDB (default). For Atlas use: mongodb+srv://<user>:<password>@<cluster>/overtakejs
MONGODB_URI=mongodb://127.0.0.1:27017/overtakejs
# Signs session cookies. Required, at least 32 random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Google sign-in (optional). The redirect URI must match the Google console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback
# Where the frontend lives: CORS origin and post-login redirect.
CLIENT_URL=http://localhost:5173
# Production only: NODE_ENV=production turns on Secure cookies and hides stack
# traces. TRUST_PROXY is the number of proxies in front of the app (usually 1).
# NODE_ENV=production
# TRUST_PROXY=1
